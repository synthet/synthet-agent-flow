{
  "name": "synthet-agent-flow",
  "version": "0.1.0",
  "description": "Agent-oriented project management: dependency-aware ready queue, atomic claims, MCP server, CLI, web Kanban dashboard and Claude Code plugin.",
  "type": "module",
  "license": "MIT",
  "author": "synthet",
  "repository": "https://github.com/synthet/synthet-agent-flow",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "agent-flow": "bin/agent-flow.js",
    "af": "bin/agent-flow.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "assets",
    "plugin",
    "templates",
    "integrations",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli/main.ts",
    "serve": "node bin/agent-flow.js serve",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0"
  }
}
